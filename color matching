# ---------------------------------------------------------
# HELPER FUNCTIONS
# ---------------------------------------------------------

def hex_to_rgb(hex_color):
    """Convert HEX colour to RGB."""
    hex_color = hex_color.lstrip("#")

    if len(hex_color) == 3:
        hex_color = "".join(char * 2 for char in hex_color)

    return tuple(int(hex_color[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    """Convert RGB tuple to HEX."""
    return "#{:02X}{:02X}{:02X}".format(*rgb)


def rgb_to_hsl(rgb):
    """Convert RGB to HSL."""
    r, g, b = [value / 255 for value in rgb]

    h, l, s = colorsys.rgb_to_hls(r, g, b)

    return (
        round(h * 360),
        round(s * 100),
        round(l * 100),
    )


def hex_to_hsl(hex_color):
    """Convert HEX to HSL."""
    return rgb_to_hsl(hex_to_rgb(hex_color))


def color_distance(rgb1, rgb2):
    """
    Calculate Euclidean distance between two RGB colours.
    Lower value = more similar colour.
    """
    return math.sqrt(
        sum((a - b) ** 2 for a, b in zip(rgb1, rgb2))
    )


def find_matching_colors(hex_color, number=5):
    """Find nearest colours from the colour database."""

    target_rgb = hex_to_rgb(hex_color)

    matches = []

    for name, color_hex in COLOR_DATABASE.items():
        distance = color_distance(
            target_rgb,
            hex_to_rgb(color_hex)
        )

        matches.append(
            (name, color_hex, distance)
        )

    matches.sort(key=lambda x: x[2])

    return matches[:number]


def hsl_to_hex(h, s, l):
    """Convert HSL to HEX."""

    h = h / 360
    s = s / 100
    l = l / 100

    r, g, b = colorsys.hls_to_rgb(h, l, s)

    return rgb_to_hex(
        (
            round(r * 255),
            round(g * 255),
            round(b * 255),
        )
    )


def generate_palette(hex_color):
    """Generate a colour harmony palette."""

    h, s, l = hex_to_hsl(hex_color)

    return {
        "Original": hex_color,
        "Complementary": hsl_to_hex((h + 180) % 360, s, l),
        "Analogous 1": hsl_to_hex((h + 30) % 360, s, l),
        "Analogous 2": hsl_to_hex((h - 30) % 360, s, l),
        "Triadic 1": hsl_to_hex((h + 120) % 360, s, l),
        "Triadic 2": hsl_to_hex((h + 240) % 360, s, l),
        "Lighter": hsl_to_hex(h, s, min(l + 20, 100)),
        "Darker": hsl_to_hex(h, s, max(l - 20, 0)),
    }


def is_valid_hex(value):
    """Check whether a value is a valid HEX colour."""

    value = value.strip().replace("#", "")

    if len(value) not in (3, 6):
        return False

    try:
        int(value, 16)
        return True
    except ValueError:
        return False


